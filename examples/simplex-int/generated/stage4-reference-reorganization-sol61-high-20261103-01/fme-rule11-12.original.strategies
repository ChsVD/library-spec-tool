id : 11
priority : core(3)
left : InequList(?p, ?n, cons{<Constraint>}(?x, ?l)) at 0
action : left_erase(0);
         left_exist_add(y: Z);
         left_exist_add(h: Z);
         left_add(h != 0);
         left_add(store(field_addr(p, InequList, coef), PTR, h));
         left_add(coef_array(h, n, x));
         left_add(store(field_addr(p, InequList, next), PTR, y));
         left_add(InequList(y, n, l));
 
id : 12
