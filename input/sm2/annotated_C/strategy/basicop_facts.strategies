#include "../include/basicOp.h"

/* Pure arithmetic facts used at BasicOp call boundaries. */

id : 1
priority : sm2n_mul_bound(0)
left : 0 <= ?x at 0
       x < SM2_N_Z() at 1
       0 <= ?y at 2
       y < SM2_N_Z() at 3
check : absense(x * y < SM2_N_Z() * U256_MOD());
action : left_add(0 <= x * y);
         left_add(x * y < SM2_N_Z() * U256_MOD());
