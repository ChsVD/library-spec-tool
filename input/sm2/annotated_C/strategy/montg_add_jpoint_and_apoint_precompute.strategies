#include "../include/montg_add_jpoint_and_apoint_trace.h"

/* Goal-directed normalization for the mixed-add precomputation trace. */
id : 1
priority : core(0)
left : store_fp(?p, mont_p(?z * ?z)) at 0
right : store_fp(p, mont_p(maja_z2(z))) at 1
action : left_erase(0); right_erase(1);

id : 2
priority : core(0)
left : store_fp(?p, mont_p(?x * maja_z2(?z))) at 0
right : store_fp(p, mont_p(maja_u2(x, z))) at 1
action : left_erase(0); right_erase(1);

id : 3
priority : core(0)
left : store_fp(?p, mont_p(?z * maja_z2(z))) at 0
right : store_fp(p, mont_p(maja_z3(z))) at 1
action : left_erase(0); right_erase(1);

id : 4
priority : core(0)
left : store_fp(?p, mont_p(?y * maja_z3(?z))) at 0
right : store_fp(p, mont_p(maja_s2(y, z))) at 1
action : left_erase(0); right_erase(1);

id : 101
priority : core(0)
right : 0 <= maja_z2(?z) at 0
        maja_z2(z) < SM2_P_Z() at 1
action : right_erase(0); right_erase(1);

id : 103
priority : core(0)
right : 0 <= maja_z3(?z) at 0
        maja_z3(z) < SM2_P_Z() at 1
action : right_erase(0); right_erase(1);

id : 105
priority : core(0)
right : 0 <= maja_h(?x1, ?x2, ?z1) at 0
        maja_h(x1, x2, z1) < SM2_P_Z() at 1
action : right_erase(0); right_erase(1);

id : 106
priority : core(0)
right : 0 <= maja_r(?y1, ?y2, ?z1) at 0
        maja_r(y1, y2, z1) < SM2_P_Z() at 1
action : right_erase(0); right_erase(1);
