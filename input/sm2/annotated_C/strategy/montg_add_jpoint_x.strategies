id : 8
priority : core(0)
left : store_fp(?p,
         Zmod(mont_p(aj_rr2(?y1, ?z1, ?y2, ?z2)) -
              mont_p(aj_base(?x1, z1, ?x2, z2)), SM2_P_Z())) at 0
right : store_fp(p, mont_p(aj_rx(x1, y1, z1, x2, y2, z2))) at 1
action : left_erase(0); right_erase(1);

