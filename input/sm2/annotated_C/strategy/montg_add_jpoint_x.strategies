#include "../include/montg_add_jpoint_strategy.h"

/* Goal-directed normalization for the X-coordinate trace. */
id : 1
priority : core(0)
left : store_fp(?p,
         Zmod(mont_p(aj_u1(?x1, ?z2)) - mont_p(aj_u2(?x2, ?z1)),
              SM2_P_Z())) at 0
right : store_fp(p, mont_p(aj_h(x1, z1, x2, z2))) at 1
action : left_erase(0); right_erase(1);

id : 2
priority : core(0)
left : store_fp(?p,
         Zmod(mont_p(aj_s1(?y1, ?z2)) - mont_p(aj_s2(?y2, ?z1)),
              SM2_P_Z())) at 0
right : store_fp(p, mont_p(aj_rr(y1, z1, y2, z2))) at 1
action : left_erase(0); right_erase(1);

id : 3
priority : core(0)
left : store_fp(?p,
