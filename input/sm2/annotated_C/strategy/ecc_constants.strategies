#include "../include/ecc.h"

/* Canonical resources for SM2 curve and point constants. */

id : 10
priority : core(0)
left : store_sm2_a() at 0
right : store_sm2_a() at 1
action : left_erase(0);
         right_erase(1);

id : 11
priority : open_sm2_a(0)
left : store_sm2_a() at 0
