#include "../include/montg_add_jpoint_strategy.h"

/* Goal-directed normalization for the Montgomery precomputation trace. */
id : 1
priority : core(0)
left : store_fp(?p, mont_p(?z * ?z)) at 0
right : store_fp(p, mont_p(aj_pz2(z))) at 1
action : left_erase(0); right_erase(1);

id : 2
priority : core(0)
left : store_fp(?p, mont_p(?z * ?z)) at 0
right : store_fp(p, mont_p(aj_qz2(z))) at 1
