#include "../include/basicOp.h"

/* Exact memory layouts of the read-only SM2 constants. */

id : 10
priority : core(0)
left : store_sm2_p() at 0
right : store_sm2_p() at 1
action : left_erase(0);
         right_erase(1);

id : 11
priority : open_sm2_p(0)
left : store_sm2_p() at 0
action : left_erase(0);
         left_add(UInt64Array::full(field_addr(SM2_P, u32, v), 4,
           cons{Z}(SM2_P_LIMB_0(), cons{Z}(SM2_P_LIMB_1(),
           cons{Z}(SM2_P_LIMB_2(), cons{Z}(SM2_P_LIMB_3(), nil{Z}()))))));

