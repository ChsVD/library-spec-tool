/* Fold implementation-level constant resources back to their named public
 * resources.  The forward direction is intentionally explicit [do]/[by] at
 * the actual read boundary. */
id : 81
priority : core(4)
left : store_u256(SM2_P, ?x) at 0
right : store_sm2_p() at 1
action : left_erase(0);
         right_erase(1);
         right_add(x == SM2_P_Z());

