#include "../include/montg_add_jpoint_strategy.h"

/* Goal-directed normalization for the Z-coordinate trace. */
id : 1
priority : core(0)
left : store_fp(?p, mont_p(?z1 * ?z2)) at 0
right : store_fp(p, mont_p(aj_zbase(z1, z2))) at 1
action : left_erase(0); right_erase(1);

id : 2
priority : core(0)
left : store_fp(?p,
         mont_p(aj_zbase(?z1, ?z2) * aj_h(?x1, z1, ?x2, z2))) at 0
right : store_fp(p, mont_p(aj_rz(x1, z1, x2, z2))) at 1
action : left_erase(0); right_erase(1);

id : 101
priority : core(0)
right : 0 <= aj_zbase(?z1, ?z2) at 0
        aj_zbase(z1, z2) < SM2_P_Z() at 1
action : right_erase(0); right_erase(1);
