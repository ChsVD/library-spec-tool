         0, SM2_TABLE_RECORDS(),
         sm2_table_flatten(SM2_MONT_BASE_TABLE_DATA())) at 0
       record_afpoint_well_formed(
         sm2_mont_base_table_record_at(limb, window, byte)) at 1
       store_mont_afpoint(
         ?selected,
         sm2_point_mul(
           sm2_table_term(byte, limb, window), SM2_G_POINT())) at 2
check : infer(0 <= limb);
        infer(limb < 4);
        infer(0 <= window);
        infer(window < 8);
        infer(0 <= byte);
        infer(byte < 256);
        infer(selected ==
          pointer_offset(
            pointer_offset(
              pointer_offset(base, limb, struct AFPoint[256][8]),
              window, struct AFPoint[256]),
            byte, struct AFPoint));
action : left_erase(2);
         left_erase(1);
         left_erase(0);
