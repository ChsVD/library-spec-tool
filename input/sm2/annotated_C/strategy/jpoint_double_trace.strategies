/* Montgomery-domain analogue.  The soundness proofs keep all mont_p
 * congruence reasoning out of ordinary function VCs. */
id : 112
priority : jdouble_trace_mont(0)
left : store_fp(?p, mont_p(jdouble_trace_s2(?y) * jdouble_trace_s2(y))) at 0
action : left_erase(0); left_add(0 <= jdouble_trace_m4(y)); left_add(jdouble_trace_m4(y) < SM2_P_Z()); left_add(store_fp(p, mont_p(jdouble_trace_m4(y))));

