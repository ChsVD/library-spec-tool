#include "../include/jpoint_double_trace.h"

/* Ordinary-domain trace normalization.  This scope is invoked after one
 * field operation and rewrites every newly available raw result. */
id : 12
priority : jdouble_trace_plain(0)
left : store_fp(?p, Zmod(jdouble_trace_s2(?y) * jdouble_trace_s2(y), SM2_P_Z())) at 0
action : left_erase(0); left_add(store_fp(p, jdouble_trace_m4(y)));

