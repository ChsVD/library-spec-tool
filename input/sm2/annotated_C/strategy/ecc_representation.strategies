/* Start an in-place overwrite directly from the aggregate field predicate.
 * Only the selected coordinate is forgotten; the frame stays at store_fp. */
id : 126
priority : core(0)
left : store_jpoint_fields(?p, ?x, ?y, ?z) at 0
right : UInt64Array::undef_full(
          field_addr(field_addr(?q, JPoint, x), u32, v), 4) at 1
check : infer(p == q);
action : left_erase(0);
         right_erase(1);
         left_add(store_fp(field_addr(p, JPoint, y), y));
         left_add(store_fp(field_addr(p, JPoint, z), z));

