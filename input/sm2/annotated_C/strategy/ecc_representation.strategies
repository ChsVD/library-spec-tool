/* Abstract affine-point resources. */
id : 30
priority : core(0)
left : store_afpoint(?p, ?point) at 0
right : store_afpoint(p, point) at 1
action : left_erase(0);
         right_erase(1);

id : 31
priority : open_afpoint(0)
left : store_afpoint(?p, ?point) at 0
action : left_erase(0);
         left_exist_add(x : Z);
         left_exist_add(y : Z);
         left_add(afpoint_represents(x, y, point));
         left_add(store_afpoint_fields(p, x, y));

id : 32
priority : core(3)
right : store_afpoint(?p, ?point) at 0
action : right_erase(0);
         right_exist_add(x : Z);
         right_exist_add(y : Z);
         right_add(afpoint_represents(x, y, point));
         right_add(store_afpoint_fields(p, x, y));

