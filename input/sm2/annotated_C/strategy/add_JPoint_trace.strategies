/* Case-local normalization from leaf arithmetic results to the stable names
 * used by add_JPoint's straight-line proof trace. */
#include "../include/add_JPoint_trace.h"

id : 10
priority : aj_pz2_step(0)
left : store_fp(?p, Zmod(?z * ?z, SM2_P_Z())) at 0
action : left_erase(0); left_add(store_fp(p, aj_pz2(z)));

id : 11
priority : aj_qz2_step(0)
left : store_fp(?p, Zmod(?z * ?z, SM2_P_Z())) at 0
action : left_erase(0); left_add(store_fp(p, aj_qz2(z)));

id : 12
priority : aj_trace_step(0)
left : store_fp(?p, Zmod(aj_pz2(?z) * z, SM2_P_Z())) at 0
action : left_erase(0); left_add(store_fp(p, aj_pz3(z)));

