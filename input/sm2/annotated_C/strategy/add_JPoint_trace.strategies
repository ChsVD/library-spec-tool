/* Exceptional public-point branches.  These rules expose only the abstract
 * group identities; their generated soundness goals are proved in Rocq. */
id : 34
priority : aj_inf_left(0)
left : jpoint_represents(?x1, ?y1, ?z1, ?P1) at 0
       jpoint_represents(?x2, ?y2, ?z2, ?P2) at 1
       x1 == 1 at 2
       y1 == 1 at 3
       z1 == 0 at 4
action : left_add(sm2_point_add(P1, P2) == P2);

id : 35
priority : aj_inf_right(0)
left : jpoint_represents(?x1, ?y1, ?z1, ?P1) at 0
       jpoint_represents(?x2, ?y2, ?z2, ?P2) at 1
       x2 == 1 at 2
       y2 == 1 at 3
       z2 == 0 at 4
action : left_add(sm2_point_add(P1, P2) == P1);

id : 36
priority : aj_finite(0)
left : jpoint_represents(?x, ?y, ?z, ?P) at 0
       jpoint_canonical_infinity_encoding(x, y, z, P) at 1
       aj_noncanonical_infinity(x, y, z) at 2
action : left_add(z != 0);
