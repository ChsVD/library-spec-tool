    "source-14bacbce82fc68628fa5e236": {
      "id": "source-14bacbce82fc68628fa5e236",
      "path": "project/target/utils/gcd.c",
      "file_sha256": "1271bd4110687adb64c99a2ada73fe66ee46e7e9c3543e03cb7b8c355a6d0652",
      "kind": "function_source",
      "file_id": "file-77a6490c932afc8e09ead2bb",
      "start_line": 30,
      "end_line": 58,
      "text": "uint32_t gcd32(uint32_t a, uint32_t b) {\n  uint32_t x;\n  uint32_t k;\n\n  assert(a>0 && b>0);\n\n  k = 1;\n  x = a | b;\n  while ((x & 1) == 0) {\n    k <<= 1;\n    x >>= 1;\n    a >>= 1;\n    b >>= 1;\n  }\n\n  do {\n    if ((a & 1) == 0) {\n      a >>= 1;\n    } else if ((b & 1) == 0) {\n      b >>= 1;\n    } else if (a >= b) {\n      a = (a - b) >> 1;\n    } else {\n      b = (b - a) >> 1;\n    }\n  } while (a > 0);\n\n  return b * k;\n}"
    }
  },
